# Ditado — variáveis de ambiente
#
# Copie este arquivo para backend/.env e preencha os valores.
# backend/.env não é versionado. Nenhum valor real deve ser colocado aqui.

# Banco de dados (valores do docker-compose.yml de desenvolvimento)
DATABASE_HOST=localhost
# Porta publicada no computador pelo docker-compose.yml (127.0.0.1:5433). A 5432 fica livre
# para um PostgreSQL já instalado na máquina. Padrão de desenvolvimento, não é segredo.
DATABASE_PORT=5433
DATABASE_USER=ditado
DATABASE_PASSWORD=
DATABASE_NAME=ditado

# Autenticação JWT
# JWT_SECRET: texto longo e aleatório; quem o conhece emite tokens válidos
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Administrador inicial, criado na primeira inicialização se não existir
# ADMIN_EMAIL: e-mail do administrador (guardado em minúsculas)
# ADMIN_PASSWORD: senha inicial do administrador (mínimo 8 caracteres; guardada só como hash)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Transcrição de áudio
# TRANSCRIPTION_PROVIDER: groq ou openrouter. Se vazio, usa groq quando GROQ_API_KEY
# estiver preenchida e, senão, openrouter quando OPENROUTER_API_KEY estiver preenchida.
# Sem nenhuma chave, a aplicação sobe e o envio de áudio responde 502.
TRANSCRIPTION_PROVIDER=

# Groq: chave pessoal, começa com gsk_
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# OpenRouter: chave pessoal, começa com sk-or-
# OPENROUTER_MODEL: modelo de fala para texto (padrão openai/whisper-large-v3-turbo)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/whisper-large-v3-turbo

# Login com Google
# GOOGLE_CLIENT_ID: client ID OAuth do Google (termina em .apps.googleusercontent.com).
# É público, não é segredo. O client secret não é usado e não deve ficar no repositório.
# Sem ele, GET /api/auth/google responde 404 e o botão do Google não aparece.
GOOGLE_CLIENT_ID=

# API
PORT=3000

# Documentação da API (Swagger) em /docs, protegida por autenticação Basic.
# Se omitidas, o padrão de desenvolvimento é admin / admin. Troque fora do ambiente local.
DOCS_USER=
DOCS_PASSWORD=
